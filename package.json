{
  "name": "tiny-consoles",
  "version": "0.1.0",
  "description": "Small design experiments, collected over time. Each one is a Web Component, with a React wrapper.",
  "license": "MIT",
  "author": "nonsenseblue",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonsenseblue/tiny-consoles.git"
  },
  "homepage": "https://nonsenseblue.github.io/tiny-consoles/",
  "exports": {
    "./react": {
      "types": "./react/dist/index.d.ts",
      "default": "./react/dist/index.js"
    },
    "./components/*": "./components/*"
  },
  "files": [
    "components",
    "react/dist"
  ],
  "sideEffects": [
    "./components/*/src/*.js"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "web-components",
    "react",
    "creative-coding",
    "generative-art"
  ],
  "scripts": {
    "build": "tsc -p react",
    "prepare": "tsc -p react"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  }
}
